{
  "name": "@ct-jyjntc/pi-web",
  "version": "1.0.5",
  "description": "Local coding-agent workspace — desktop app:// + dual IPC runtimes, or browser UI",
  "homepage": "https://github.com/ct-jyjntc/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ct-jyjntc/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/ct-jyjntc/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "electron/main.js",
  "author": "ct-jyjntc",
  "files": [
    "bin",
    "electron",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs && node scripts/ensure-electron-adhoc-sign.mjs && node scripts/bundle-builtin-extensions.mjs",
    "dev": "node scripts/fix-node-pty-perms.mjs && next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "node scripts/fix-node-pty-perms.mjs && next dev -H 0.0.0.0 -p 30141",
    "build": "node scripts/fix-node-pty-perms.mjs && next build --webpack",
    "build:electron": "npm run bundle:extensions && npm run desktop:build && npm run build && node scripts/prepare-electron-standalone.mjs && node scripts/bundle-runtime-node.mjs && node scripts/bundle-pi-cli.mjs",
    "desktop:dev": "vite",
    "desktop:build": "vite build",
    "daemon": "node daemon/ipc-host.mjs",
    "start": "node scripts/fix-node-pty-perms.mjs && next start -H 127.0.0.1 -p 30141",
    "start:lan": "node scripts/fix-node-pty-perms.mjs && next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:electron-notify": "node scripts/smoke-electron-notify.mjs",
    "electron": "node scripts/fix-node-pty-perms.mjs && node scripts/ensure-electron-adhoc-sign.mjs && electron .",
    "electron:dev": "npm run electron",
    "electron:daemon": "npm run desktop:build && PI_WEB_RUNTIME=daemon npm run electron",
    "electron:prod": "npm run build:electron && npm run electron",
    "electron:rebuild": "npm run electron:prod",
    "dist:dmg": "npm run build:electron && electron-builder --mac dmg",
    "dist:mac": "npm run build:electron && electron-builder --mac dmg zip",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "bundle:extensions": "node scripts/bundle-builtin-extensions.mjs",
    "bundle:sdk": "node scripts/bundle-pi-sdk.mjs",
    "smoke:ipc": "node scripts/smoke-ipc-runtime.mjs",
    "smoke:flows": "node scripts/smoke-ipc-flows.mjs",
    "smoke:sdk-bundle": "node scripts/sdk-bundle-compare.mjs --target .next/standalone"
  },
  "build": {
    "appId": "com.ct-jyjntc.pi-web",
    "productName": "Pi Web",
    "copyright": "Copyright © ct-jyjntc",
    "directories": {
      "output": "dist",
      "buildResources": "electron/icons"
    },
    "files": [
      "electron/*.js",
      "electron/icons/icon.icns",
      "electron/icons/icon.png",
      "electron/icons/icon.ico",
      "package.json",
      "!node_modules/**/*",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      }
    ],
    "afterPack": "./scripts/electron-after-pack.mjs",
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ],
    "mac": {
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Pi Web ${version}",
      "artifactName": "Pi-Web-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "electron/icons",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Web-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@gotgenes/pi-permission-system": "24.0.0",
    "@gotgenes/pi-subagents": "19.2.1",
    "@lobehub/icons": "^5.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.9",
    "node-pty": "^1.1.0",
    "pi-mcp-adapter": "2.17.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "8.5.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.5.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "2.7.0",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "6.3.5"
  }
}
